# OpenRouter (server-only — never NEXT_PUBLIC_*)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Tejarify Postgres — copy DATABASE_URL from your Tejarify .env
DATABASE_URL=

# Which merchant's data Jef should read
TEJARIFY_USER_EMAIL=tejarify@peham.ltd
# Or set TEJARIFY_USER_ID=<uuid> instead
